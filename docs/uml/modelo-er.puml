@startuml modelo-er
title FitApp - Modelo entidad-relación (Postgres / Supabase)
hide circle
skinparam linetype ortho

entity "auth.users" as users {
  * id : uuid <<PK>>
  --
  email : text
}

entity profile {
  * user_id : uuid <<PK,FK>>
  --
  display_name : text
  sex : text
  birth_date : date
  height_cm : numeric
  bmr_formula : text
  bmr_measured_kcal : numeric
  sedentary_steps_threshold : int
  stride_m : numeric
  timezone : text
}

entity activity_schedule {
  * user_id : uuid <<PK,FK>>
  * weekday : smallint <<PK>>
  --
  mode : text
  level : text
  custom_factor : numeric
  steps_target : int
}

entity daily_activity {
  * user_id : uuid <<PK,FK>>
  * day : date <<PK>>
  --
  mode : text
  level : text
  custom_factor : numeric
  steps_actual : int
}

entity goal {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  target_weight_kg : numeric
  target_bmi : numeric
  weekly_rate_kg : numeric
  start_date : date
  active : boolean
}

entity body_measurement {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  measured_at : timestamptz
  weight_kg : numeric
  waist_cm : numeric
  body_fat_pct : numeric
}

entity activity_type {
  * id : int <<PK>>
  --
  code : text <<UQ>>
  name_es : text
  met : numeric
  category : text
}

entity workout_session {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * activity_type_id : int <<FK>>
  started_at : timestamptz
  duration_min : numeric
  distance_km : numeric
  machine_kcal : numeric
  hr_avg : int
  hr_min : int
  hr_max : int
  rpe : int
  kcal_hr : numeric
  kcal_met : numeric
  kcal_selected : numeric
  kcal_method : text
  kcal_net : numeric
}

entity workout_template {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * activity_type_id : int <<FK>>
  name : text
  duration_min : numeric
}

entity food {
  * id : uuid <<PK>>
  --
  name_es : text
  name_en : text
  brand : text
  barcode : text
  category : text
  state : text
  basis : text
  density_g_ml : numeric
  source : text
  source_id : text
  license : text
  owner_user_id : uuid <<FK, null = público>>
  search_vector : tsvector
  imported_at : timestamptz
}

entity nutrient {
  * id : int <<PK>>
  --
  code : text <<UQ>>
  unit : text
}

entity food_nutrient {
  * food_id : uuid <<PK,FK>>
  * nutrient_id : int <<PK,FK>>
  --
  amount_per_100 : numeric
}

entity food_portion {
  * id : uuid <<PK>>
  --
  * food_id : uuid <<FK>>
  label_es : text
  grams : numeric
}

entity recipe {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * food_id : uuid <<FK>>
  name : text
  cooked_weight_g : numeric
}

entity recipe_ingredient {
  * recipe_id : uuid <<PK,FK>>
  * food_id : uuid <<PK,FK>>
  --
  grams : numeric
}

entity favorite_food {
  * user_id : uuid <<PK,FK>>
  * food_id : uuid <<PK,FK>>
}

entity meal_entry {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  eaten_at : timestamptz
  meal_type : text
}

entity meal_item {
  * id : uuid <<PK>>
  --
  * meal_entry_id : uuid <<FK>>
  * food_id : uuid <<FK>>
  portion_id : uuid <<FK>>
  quantity : numeric
  unit : text
  grams_resolved : numeric
  kcal : numeric
  protein_g : numeric
  carb_g : numeric
  fat_g : numeric
}

users ||--|| profile
users ||--o{ activity_schedule
users ||--o{ daily_activity
users ||--o{ goal
users ||--o{ body_measurement
users ||--o{ workout_session
users ||--o{ workout_template
users ||--o{ meal_entry
users ||--o{ recipe
users |o--o{ food
users ||--o{ favorite_food
activity_type ||--o{ workout_session
activity_type ||--o{ workout_template
food ||--o{ food_nutrient
nutrient ||--o{ food_nutrient
food ||--o{ food_portion
food ||--o{ recipe_ingredient
recipe ||--|{ recipe_ingredient
recipe ||--|| food
food ||--o{ favorite_food
meal_entry ||--|{ meal_item
food ||--o{ meal_item
food_portion |o--o{ meal_item
@enduml
