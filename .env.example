# Copia este archivo a .env.local y completa los valores.
# Supabase → Project Settings → API Keys.

# Públicas (llegan al navegador; la seguridad la dan las políticas RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secreta: solo para scripts de ingesta y código de servidor. Nunca con prefijo NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...
